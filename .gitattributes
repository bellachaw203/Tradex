# Normalise line endings so CI (Linux) and local checkouts (often Windows) see
# identical bytes. Without this, a CRLF-checked-out shell script fails on the
# runner with a confusing `bad interpreter: /bin/bash^M`.

* text=auto eol=lf

# Scripts must be LF regardless of platform — they are executed by the runner.
*.sh            text eol=lf
*.bash          text eol=lf
.githooks/*     text eol=lf

# Windows-native files keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ── Binary: never diffed, never normalised ───────────────────────────────────
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.wasm          binary
*.bin           binary
*.zkey          binary
*.r1cs          binary
*.ptau          binary
*.wtns          binary

# ── Generated: collapsed in PR diffs, excluded from language statistics ──────
package-lock.json   linguist-generated=true -diff
bun.lock            linguist-generated=true -diff
Cargo.lock          linguist-generated=true -diff
circuits/keys/**    linguist-generated=true
app/build/**        linguist-generated=true

# Vendored sub-projects should not dominate the repository language breakdown.
tiny/**             linguist-vendored=true
tee-zk-stellar/**   linguist-vendored=true
