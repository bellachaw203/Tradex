# Every value here is OPTIONAL. The app ships with the live Stellar Testnet
# deployment baked into `app/app/lib/contracts.ts` (TESTNET_DEPLOYMENT), so
# `npm run dev` works with no configuration at all.
#
# Set a variable below only to point the app at a different deployment —
# for example after running `./scripts/deploy-testnet.sh` yourself.

# ── Deployed contract IDs ────────────────────────────────────────────
VITE_PERP_ENGINE_ID=
VITE_ORDERBOOK_ID=
VITE_COLLATERAL_TOKEN_ID=

# ── Network ──────────────────────────────────────────────────────────
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── TEE match server ─────────────────────────────────────────────────
# Leave unset to use the same-origin /tee proxy (vite dev proxy → 127.0.0.1:9721).
VITE_TEE_URL=http://localhost:9721

# ── Read-only simulation source ──────────────────────────────────────
# Any funded public key on the target network. Used only as the source
# account for simulateTransaction; it never signs.
VITE_SIMULATION_SOURCE=

# ── Test USDC faucet (local / testnet only) ──────────────────────────
# Secret key of the collateral token issuer. Required ONLY for the in-app
# "mint test USDC" button; every other feature works without it.
# This puts a signing key in the browser bundle — never use a real key,
# and never commit a value here.
VITE_MINTER_SECRET=
