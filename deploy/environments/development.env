# Development environment — Stellar Testnet, deployed from any branch.
#
# Values here are non-secret configuration only. Credentials come from GitHub
# Environment secrets (see docs/ci-cd/SECRETS.md); never put a key in this file.

ENVIRONMENT=development

# ── Stellar network ──────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Deployer ─────────────────────────────────────────────────────────────────
# The stellar CLI identity name. Its secret key is supplied at runtime by the
# STELLAR_DEPLOYER_SECRET environment secret.
DEPLOYER_IDENTITY=tradex-deployer-dev

# Testnet accounts can be topped up from friendbot; mainnet obviously cannot.
ALLOW_FRIENDBOT_FUNDING=true

# ── Contracts to deploy ──────────────────────────────────────────────────────
CONTRACTS="orderbook perp_engine shielded_pool collateral verifier_groth16"

# ── Post-deploy steps ────────────────────────────────────────────────────────
INITIALIZE_PERP_ENGINE=true
REGISTER_MARKETS=true

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the built SPA goes. "none" uploads the bundle as a workflow artifact
# and stops there — see deploy/frontend.sh for the supported targets.
FRONTEND_DEPLOY_TARGET=none

# ── Guard rails ──────────────────────────────────────────────────────────────
REQUIRE_CLEAN_TREE=false
REQUIRE_APPROVAL=false
