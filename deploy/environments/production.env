# Production environment — Stellar Mainnet.
#
# ⚠️  Deployments here move real value. The GitHub Environment named
#     "production" must have required reviewers configured; see
#     docs/ci-cd/DEPLOYMENT.md for the repository settings that enforce it.
#
# Values here are non-secret configuration only. Credentials come from GitHub
# Environment secrets (see docs/ci-cd/SECRETS.md); never put a key in this file.

ENVIRONMENT=production

# ── Stellar network ──────────────────────────────────────────────────────────
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
HORIZON_URL=https://horizon.stellar.org

# ── Deployer ─────────────────────────────────────────────────────────────────
DEPLOYER_IDENTITY=tradex-deployer-prod

# No friendbot on mainnet: the deployer must be funded ahead of time, and the
# deploy fails loudly rather than half-completing if it is not.
ALLOW_FRIENDBOT_FUNDING=false

# ── Contracts to deploy ──────────────────────────────────────────────────────
CONTRACTS="orderbook perp_engine shielded_pool collateral verifier_groth16"

# ── Post-deploy steps ────────────────────────────────────────────────────────
# Market registration on mainnet is a separate, deliberately manual operation:
# it seeds oracle prices, and getting one wrong mis-prices a live market.
INITIALIZE_PERP_ENGINE=true
REGISTER_MARKETS=false

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_DEPLOY_TARGET=none

# ── Guard rails ──────────────────────────────────────────────────────────────
REQUIRE_CLEAN_TREE=true
REQUIRE_APPROVAL=true
ALLOWED_BRANCHES=main
REQUIRE_TAG=true
