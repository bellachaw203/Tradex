# Staging environment — Stellar Testnet, deployed from main only.
#
# Staging mirrors production's process (same scripts, same guard rails) against
# the test network, so a release is rehearsed before it touches real value.
#
# Values here are non-secret configuration only. Credentials come from GitHub
# Environment secrets (see docs/ci-cd/SECRETS.md); never put a key in this file.

ENVIRONMENT=staging

# ── Stellar network ──────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Deployer ─────────────────────────────────────────────────────────────────
DEPLOYER_IDENTITY=tradex-deployer-staging
ALLOW_FRIENDBOT_FUNDING=true

# ── Contracts to deploy ──────────────────────────────────────────────────────
CONTRACTS="orderbook perp_engine shielded_pool collateral verifier_groth16"

# ── Post-deploy steps ────────────────────────────────────────────────────────
INITIALIZE_PERP_ENGINE=true
REGISTER_MARKETS=true

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_DEPLOY_TARGET=none

# ── Guard rails ──────────────────────────────────────────────────────────────
# Staging deploys only from main, and only from a tree that matches the commit
# being deployed — the same rules production uses.
REQUIRE_CLEAN_TREE=true
REQUIRE_APPROVAL=false
ALLOWED_BRANCHES=main
